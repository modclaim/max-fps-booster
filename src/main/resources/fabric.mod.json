{
  "schemaVersion": 1,
  "id": "max-fps-booster",
  "version": "${version}",
  "name": "Max FPS booster",
  "description": "Ultra-high-performance FPS booster and dynamic FPS display overlay for Minecraft Fabric.",
  "authors": [
    "modclaim"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/max-fps-booster",
    "sources": "https://github.com/modclaim/max-fps-booster",
    "issues": "https://github.com/modclaim/max-fps-booster/issues"
  },
  "license": "MIT",
  "icon": "assets/max-fps-booster/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.fpsbooster.FpsBoosterMod"
    ],
    "client": [
      "com.fpsbooster.client.FpsBoosterClient"
    ],
    "modmenu": [
      "com.fpsbooster.gui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "max-fps-booster.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.161.0+26.3"
  },
  "suggests": {
    "modmenu": "*",
    "sodium": "*"
  }
}
